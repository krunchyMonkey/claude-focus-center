{
  "name": "claude-focus-center",
  "displayName": "Claude Focus Center",
  "description": "Local-first attention queue across Claude Code sessions.",
  "version": "0.0.1",
  "publisher": "krunchymonkey",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krunchyMonkey/claude-focus-center.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "focusCenter",
          "title": "Focus Center",
          "icon": "media/focus-center.svg"
        }
      ]
    },
    "views": {
      "focusCenter": [
        {
          "id": "focusCenter.queue",
          "name": "Attention Queue",
          "contextualTitle": "Focus Center"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "focusCenter.queue",
        "contents": "No Claude Code sessions found.\nFocus Center reads session metadata from your local Claude Code folder (read-only, nothing leaves this machine).\n[Refresh](command:focusCenter.refresh)\n[Show Diagnostics](command:focusCenter.showDiagnostics)"
      }
    ],
    "commands": [
      {
        "command": "focusCenter.refresh",
        "title": "Refresh",
        "category": "Focus Center",
        "icon": "$(refresh)"
      },
      {
        "command": "focusCenter.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "Focus Center",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "focusCenter.refresh",
          "when": "view == focusCenter.queue",
          "group": "navigation@1"
        },
        {
          "command": "focusCenter.showDiagnostics",
          "when": "view == focusCenter.queue",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Focus Center",
      "properties": {
        "focusCenter.excludedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "Project folders whose Claude Code sessions are never read. A path also excludes its subfolders; `~` expands to your home folder. Matching errs towards exclusion."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "typecheck": "tsc -p . --noEmit",
    "test:unit": "npm run compile && node --test \"out/test/unit/**/*.test.js\"",
    "test:host": "npm run compile && node ./out/test/runHostTests.js",
    "test": "npm run test:unit && npm run test:host",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "typescript": "7.0.2"
  }
}
